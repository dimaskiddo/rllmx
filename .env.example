# Copy to .env and edit. The process environment overrides this file. Every
# variable has a default in config/, so only the ones marked "required" must be
# set. A value that contains a dollar sign must be wrapped in single quotes,
# because $NAME in an unquoted or double-quoted value is expanded.
# Never commit .env.

# ---------------------------------------------------------------------------
# Application
#
# APP_KEY   required. Exactly 32 characters, made with: ./artisan key:generate
#           The framework stops at start without it. Keep it secret and keep it
#           the same across restarts. It is the framework's key, not the key that
#           seals provider credentials in the database.
# APP_NAME  shown by "artisan about". Default: Router-LLM.
# APP_ENV   local, staging or production. Default: production. The name is
#           written in front of every log line.
# APP_DEBUG true shows more detail in the framework's own messages. Keep it false
#           on any server people can reach.
APP_KEY=
APP_NAME=Router-LLM
APP_ENV=production
APP_DEBUG=false

# ---------------------------------------------------------------------------
# Network
#
# APP_HOST  the address the server listens on. 127.0.0.1 accepts this machine
#           only. Use 0.0.0.0 in a container, or to accept other machines (then
#           put an API key in front of every client).
# APP_PORT  the port. Default 20128, the port 9router uses, so clients keep
#           their base URL.
# APP_URL   the address people reach the gateway at, for example
#           https://gw.example.com. Set it when you sign in through OIDC or SAML
#           from another machine; empty is fine for local use.
APP_HOST=127.0.0.1
APP_PORT=20128
APP_URL=

# HTTP_SERVER_READ_HEADER_TIMEOUT  how long a client may take to send its request
#                                  headers. 1s to 5m. Default 10s.
# HTTP_SERVER_IDLE_TIMEOUT         how long an idle keep-alive connection is kept.
#                                  1s to 1h. Default 120s.
# HTTP_SERVER_SHUTDOWN_GRACE       how long a shutdown lets running requests
#                                  finish; a second signal exits at once.
#                                  1s to 10m. Default 30s.
# There is no whole-request timeout, because a stream runs for minutes.
HTTP_SERVER_READ_HEADER_TIMEOUT=10s
HTTP_SERVER_IDLE_TIMEOUT=120s
HTTP_SERVER_SHUTDOWN_GRACE=30s

# SERVER_MAX_BODY_MB      the largest client API request body. Default 128.
# SERVER_TRUST_LOOPBACK   true treats a request from this machine as local. Set
#                         false behind a tunnel or reverse proxy on this same
#                         machine (cloudflared, ngrok, tailscale serve, nginx),
#                         because its traffic arrives from 127.0.0.1.
# SERVER_TRUSTED_PROXIES  addresses or CIDR ranges, comma separated, whose
#                         X-Forwarded-For and X-Forwarded-Proto are believed.
#                         Empty: loopback only.
SERVER_MAX_BODY_MB=128
SERVER_TRUST_LOOPBACK=true
SERVER_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Auth
#
# AUTH_INITIAL_PASSWORD  the dashboard password accepted while none is stored.
#                        Empty uses the built-in default, which is public: a
#                        remote login on it is refused until you change it.
# AUTH_API_KEY_SECRET    the checksum secret of an API key. Copy the 9router
#                        API_KEY_SECRET value, or keys migrated from it stop
#                        reading as "ok" in `keys:list`.
# AUTH_MACHINE_ID_SALT   salt of the machine id inside every new key. Same rule.
# AUTH_COOKIE_SECURE     true forces the Secure flag on the dashboard cookie.
#                        Leave it false when TLS ends at this process or at a
#                        proxy listed in SERVER_TRUSTED_PROXIES.
# AUTH_REFUSE_DEFAULT_PASSWORD  true refuses to start while the dashboard
#                        password is still a public default.
AUTH_INITIAL_PASSWORD=
AUTH_API_KEY_SECRET=
AUTH_MACHINE_ID_SALT=
AUTH_COOKIE_SECURE=false
AUTH_REFUSE_DEFAULT_PASSWORD=false

# ---------------------------------------------------------------------------
# Auth: single sign-on
#
# AUTH_SSO_ALLOW  who may sign in through the configured identity provider:
#                 exact email addresses or @domain, comma separated, no
#                 wildcards. EMPTY ADMITS EVERY ACCOUNT THE PROVIDER ACCEPTS.
#                 On a company IdP that is the intent; on a public one the
#                 dashboard is as open as that provider's registration.
AUTH_SSO_ALLOW=

# ---------------------------------------------------------------------------
# Outbound network
#
# UPSTREAM_CONNECT_TIMEOUT  how long one outbound connection may take to
#                           establish and to start answering. 1s to 10m.
#                           Default 60s.
# UPSTREAM_ALLOW_PRIVATE    addresses, CIDR ranges or host names this program
#                           may reach when they are not public: loopback, the
#                           private ranges, carrier-grade NAT. Needed for a
#                           provider or identity provider on your own network.
#                           Link-local and the cloud metadata addresses are
#                           refused even when listed here. Empty: public only.
#                           UPSTREAM_ALLOW_PRIVATE=10.0.0.0/8,idp.internal
UPSTREAM_CONNECT_TIMEOUT=60s
UPSTREAM_ALLOW_PRIVATE=

# ---------------------------------------------------------------------------
# OAuth logins
#
# OAUTH_BACKGROUND_REFRESH  true renews Claude and Codex tokens in the background
#                           (a first pass 10s after start, then every 5 minutes),
#                           so a token is fresh before a request needs it. A
#                           request still renews a token that is due, and renews
#                           and retries once after the provider refuses one.
# OAUTH_REFRESH_DELAY       the pause between two accounts in a background pass.
#                           0s to 1m. Default 1500ms.
# OAUTH_REFRESH_GOOGLE_DELAY  the longer pause after an account of a provider
#                           Google rate-limits renewals for (Gemini CLI,
#                           Antigravity), plus up to 4s of jitter. 0s to 1m.
#                           Default 12s.
OAUTH_BACKGROUND_REFRESH=true
OAUTH_REFRESH_DELAY=1500ms
OAUTH_REFRESH_GOOGLE_DELAY=12s

# OAUTH_CALLBACK_HOST     the address the Codex login listener (port 1455)
#                         binds to. 127.0.0.1 accepts this machine only; use
#                         0.0.0.0 in a container.
# OAUTH_CLIENT_ID_CLAUDE  client id of the Claude Code command line tool, which
# OAUTH_CLIENT_ID_CODEX   the Claude and Codex logins use. Both are public ids
#                         that these tools publish; empty switches that login
#                         off. A login only works on the redirect the tool
#                         registered, so replace an id only with an app of your
#                         own and register the redirect the dashboard shows.
# OAUTH_CLIENT_ID_GITHUB  client id of the GitHub Copilot editor plugin, for the
#                         GitHub device login. A public id; empty switches the
#                         login off.
# OAUTH_CLIENT_ID_KIMI    client ids of the Kimi, Meta Muse, Nous and xAI command
# OAUTH_CLIENT_ID_MUSE    line tools, for their device logins. All are public
# OAUTH_CLIENT_ID_NOUS    ids; empty switches that login off. The xAI id also
# OAUTH_CLIENT_ID_XAI     serves the Grok CLI login.
# OAUTH_CLIENT_ID_MINIMAX_CODE  client id of MiniMax Code, for both its sites
#                         (China and global). A public id.
# OAUTH_CLIENT_ID_GOOGLE  id and secret of the Gemini CLI client, and the
# OAUTH_CLIENT_SECRET_GOOGLE  same pair for the Antigravity client below. Both
# OAUTH_CLIENT_ID_ANTIGRAVITY  are the public installed-app values these tools
# OAUTH_CLIENT_SECRET_ANTIGRAVITY  publish, so the secret protects nothing;
#                         empty switches that login off.
OAUTH_CALLBACK_HOST=127.0.0.1
OAUTH_CLIENT_ID_CLAUDE=9d1c250a-e61b-44d9-88ed-5944d1962f5e
OAUTH_CLIENT_ID_CODEX=app_EMoamEEZ73f0CkXaXp7hrann
OAUTH_CLIENT_ID_GITHUB=Iv1.b507a08c87ecfe98
OAUTH_CLIENT_ID_XAI=b1a00492-073a-47ea-816f-4c329264a828
OAUTH_CLIENT_ID_KIMI=17e5f671-d194-4dfb-9706-5516cb48c098
OAUTH_CLIENT_ID_MUSE=1031625952748946
OAUTH_CLIENT_ID_MINIMAX_CODE=mcode-public
OAUTH_CLIENT_ID_GOOGLE=681255809395-oo8ft2oprdrnp9e3aqf6av3hmdib135j.apps.googleusercontent.com
OAUTH_CLIENT_SECRET_GOOGLE=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
OAUTH_CLIENT_ID_ANTIGRAVITY=1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com
OAUTH_CLIENT_SECRET_ANTIGRAVITY=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
OAUTH_CLIENT_ID_NOUS=hermes-cli

# ---------------------------------------------------------------------------
# Streams
#
# STREAM_FIRST_CHUNK_TIMEOUT  how long to wait for the first event of a streamed
#                             answer, which is the time a model needs to read a
#                             long prompt. 5s to 1h. Default 200s.
# STREAM_STALL_TIMEOUT        how long a stream may stay silent before it is cut
#                             and the client gets an error. 5s to 1h. Default
#                             360s.
# STREAM_USAGE_WAIT           how long a finished turn waits for the usage report
#                             some upstreams send after it. 100ms to 30s.
#                             Default 3s.
STREAM_FIRST_CHUNK_TIMEOUT=200s
STREAM_STALL_TIMEOUT=360s
STREAM_USAGE_WAIT=3s

# ---------------------------------------------------------------------------
# Data
#
# DATA_DIR    the folder for everything the router keeps: the databases (db/),
#             backups, the dashboard signing secret (jwt-secret), the machine id
#             (machine-id) and skills (skills/). Created with mode 0700, files
#             0600. Empty: storage/app inside the project.
#             Keep it inside storage/, because the logs are in storage/logs and the
#             container mounts storage/ as the one volume. Use an absolute path if
#             you set it.
# JWT_SECRET  signs the dashboard login cookie. This is the name 9router uses:
#             copy its value to keep existing sessions valid. Empty: a random one
#             is created once and stored in DATA_DIR/jwt-secret.
DATA_DIR=
JWT_SECRET=

# ---------------------------------------------------------------------------
# Logs
#
# All logging goes through the framework's log channel, and an entry is cleaned
# of secrets before it is written. Nothing is written to a system temp folder.
# LOG_CHANNEL  where the log goes:
#                single  one file, storage/logs/rllmx.log, never rotated (default)
#                daily   one file per day, rllmx-YYYY-MM-DD.log, the last 7 kept
#                stack   the daily channel (the stack is declared in
#                        config/logging.go)
#              The file name, the text or json format and the retention are
#              set in config/logging.go, not here.
# LOG_LEVEL    the least important entry written: debug, info, warning, error,
#              fatal or panic. Default info. debug can show request details, so
#              do not leave it on in production.
LOG_CHANNEL=single
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
#
# DB_CONNECTION picks the engine:
#   sqlite    (default) the same SQLite file format 9router uses, so an existing
#             9router database opens as it is. Nothing else needs setting.
#   postgres  a PostgreSQL server; needs DB_HOST, DB_USERNAME and DB_PASSWORD.
# Two data sets are kept: the configuration tables (9router layout) and the
# usage rows (analytics, our own layout).
DB_CONNECTION=sqlite

# DB_ENCRYPTION_SECRET seals every stored credential (client keys, provider
# tokens, the SSO secret) with AES-256-GCM. Exactly 64 hex characters, made
# with: openssl rand -hex 32
# It is required to start the server and to run any db: command that reads a
# credential. version and health work without it. Keep a copy: a lost secret
# cannot be recovered, and the sealed values stay closed. The first start on a
# plain 9router database makes a full backup before it seals anything.
DB_ENCRYPTION_SECRET=

# ANALYTICS_RETENTION_DAYS keeps per-request usage rows this long (1 to 36500).
# The daily totals are kept for good.
ANALYTICS_RETENTION_DAYS=90

# DB_DATABASE names the configuration database.
#   sqlite    path of the file. Empty: DATA_DIR/db/data.sqlite. Point it at a
#             9router data.sqlite to reuse that install. Never open the same
#             file with 9router and Router-LLM at once.
#   postgres  the database name.
DB_DATABASE=

# DB_DATABASE_ANALYTICS names the usage database.
#   sqlite    path of the file. Empty: DATA_DIR/db/analytics.sqlite.
#   postgres  the database name. Empty: the same database as DB_DATABASE, in the
#             schema rllmx_analytics.
DB_DATABASE_ANALYTICS=

# PostgreSQL only (ignored with sqlite).
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
# Schema of the configuration tables. The usage tables always use rllmx_analytics.
DB_SCHEMA=public
# disable, allow, prefer, require, verify-ca or verify-full. The default is
# require; use it or stronger on any network you do not control.
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Cache
#
# The default store is the in-process memory store: nothing to set, nothing to
# run, and nothing shared between instances. Cached values are lost on restart.
# It is the right choice for one instance.
#
# Set REDIS_HOST to also use Redis or Valkey (same protocol) for the groups
# that may be shared (settings, key lookups, model state, response cache, tool
# call signatures). Credentials, login sessions and refreshed tokens always stay
# in memory, whatever is set here. A Redis that is down is a cache miss, never
# a failed request.
#   REDIS_HOST      empty = memory only. Otherwise the host name or address.
#   REDIS_PORT      6379 by default.
#   REDIS_PASSWORD  empty when the server needs none.
#   REDIS_DB        database number, 0 by default (not used by Valkey clusters).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# The response cache is off until the settings turn it on and an API key is
# switched on for it. While it uses the in-process store, it stops storing at
# whichever limit is reached first; with REDIS_HOST set, the server's own memory
# limit applies instead and these two are ignored.
#   CACHE_RESPONSE_MAX_ENTRIES  1 to 100000, 1000 by default.
#   CACHE_RESPONSE_MAX_MB       1 to 4096, 64 by default.
CACHE_RESPONSE_MAX_ENTRIES=1000
CACHE_RESPONSE_MAX_MB=64
