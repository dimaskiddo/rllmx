    "dialect": "kiro-social",
    "hook": "kiroSocial",
    "endpoints": {
      "profiles": "https://codewhisperer.us-east-1.amazonaws.com"
    },
    "refresh": {
      "encoding": "json",
      "url": "https://prod.us-east-1.auth.desktop.kiro.dev/refreshToken"
    }
