{
  "id": "grok-cli",
  "alias": "gcli",
  "aliases": [
    "grok-build",
    "gb"
  ],
  "category": "oauth",
  "display": {
    "name": "Grok CLI (Grok Build)"
  },
  "transport": {
    "baseUrl": "https://cli-chat-proxy.grok.com/v1/responses",
    "format": "openai-responses",
    "headers": {
      "User-Agent": "grok-shell/1.0.44 (linux; x86_64)",
      "x-grok-client-identifier": "grok-shell",
      "x-grok-client-version": "1.0.44"
    },
    "retry": {
      "429": {
        "attempts": 1,
        "delayMs": 5000
      },
      "502": {
        "attempts": 2,
        "delayMs": 1500
      },
      "503": {
        "attempts": 2,
        "delayMs": 1500
      }
    }
  },
  "oauth": {
    "flow": "device",
    "bulk": true,
    "deviceUrl": "https://auth.x.ai/oauth2/device/code",
    "tokenUrl": "https://auth.x.ai/oauth2/token",
    "scope": "openid profile email offline_access grok-cli:access api:access conversations:read conversations:write",
    "params": [
      { "name": "referrer", "value": "grok-build" }
    ],
    "hook": "grokCli",
    "endpoints": {
      "user": "https://cli-chat-proxy.grok.com/v1/user"
    },
    "callHeaders": {
      "User-Agent": "grok-pager/1.0.44 grok-shell/1.0.44 (linux; x86_64)",
      "x-xai-token-auth": "xai-grok-cli",
      "x-grok-client-version": "1.0.44"
    },
    "refresh": {
      "encoding": "form",
      "leadSeconds": 300
    }
  },
  "models": [
    {
      "id": "grok-build",
      "name": "Grok Build"
    },
    {
      "id": "grok-4.7",
      "name": "Grok 4.7"
    },
    {
      "id": "grok-4.5",
      "name": "Grok 4.5",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    {
      "id": "grok-4.5-high",
      "name": "Grok 4.5 (High)",
      "upstreamId": "grok-4.5",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    {
      "id": "grok-4.5-medium",
      "name": "Grok 4.5 (Medium)",
      "upstreamId": "grok-4.5",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    {
      "id": "grok-4.5-low",
      "name": "Grok 4.5 (Low)",
      "upstreamId": "grok-4.5",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    }
  ],
  "executor": "grok-cli",
  "forceStream": true
}
