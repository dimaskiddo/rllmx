        "token-efficient-tools-2026-03-28"
      ],
      "heavy": ["advanced-tool-use-2025-11-20", "effort-2025-11-24"],
      "heavyPrefixes": ["claude-opus", "claude-sonnet"],
      "summary": "redact-thinking-2026-02-12"
    },
    "session": { "name": "x-claude-code-session-id" },
