    "scope": "org:create_api_key user:profile user:inference",
    "params": [{ "name": "code", "value": "true" }],
    "redirect": "local",
    "exchange": "json",
    "echoState": true,
    "refresh": { "encoding": "json", "leadSeconds": 14400 },
