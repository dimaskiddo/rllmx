{
  "id": "sensenova-intl",
  "alias": "sensenova-intl",
  "category": "apikey",
  "display": {
    "name": "SenseNova (Intl)"
  },
  "transport": {
    "baseUrl": "https://token.sensenova.ai/v1/chat/completions",
    "quirks": {
      "reasoningAliasFields": true
    }
  },
  "auth": {
    "scheme": "bearer",
    "header": "Authorization",
    "validateUrl": "https://token.sensenova.ai/v1/models"
  },
  "models": [
    { "id": "sensenova-6.8-flash", "name": "SenseNova 6.8 Flash" },
    { "id": "sensenova-6.8-flash-lite", "name": "SenseNova 6.8 Flash Lite" },
    { "id": "sensenova-6.7-flash-lite", "name": "SenseNova 6.7 Flash Lite" },
    { "id": "sensenova-u1.5-lite", "name": "SenseNova U1.5 Lite", "kind": "image", "params": ["n", "size", "output_format", "response_format", "watermark", "prompt_extend"] },
    { "id": "sensenova-u1-fast", "name": "SenseNova U1 Fast", "kind": "image", "params": ["n", "size", "output_format", "response_format", "watermark", "prompt_extend"] }
  ],
  "media": {
    "serviceKinds": ["llm", "image", "imageToText"],
    "imageConfig": { "baseUrl": "https://token.sensenova.ai/v1/images/generations", "bodyFields": ["model", "prompt", "n", "size", "output_format", "response_format", "watermark", "prompt_extend"] }
  }
}
