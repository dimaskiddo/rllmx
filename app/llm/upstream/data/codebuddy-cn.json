{
  "id": "codebuddy-cn",
  "alias": "cbcn",
  "category": "oauth",
  "executor": "codebuddy-cn",
  "display": {
    "name": "CodeBuddy CN"
  },
  "forceStream": true,
  "transport": {
    "baseUrl": "https://copilot.tencent.com/v2/chat/completions",
    "format": "openai",
    "thinkingFormat": "openai",
    "headers": {
      "User-Agent": "CLI/2.108.1 CodeBuddy/2.108.1",
      "X-Product": "SaaS",
      "X-IDE-Type": "CLI",
      "X-IDE-Name": "CLI",
      "x-requested-with": "XMLHttpRequest",
      "x-codebuddy-request": "1"
    }
  },
  "auth": {
    "scheme": "bearer",
    "header": "Authorization"
  },
  "oauth": {
    "flow": "device",
    "dialect": "codebuddy",
    "noClient": true,
    "deviceUrl": "https://copilot.tencent.com/v2/plugin/auth/state",
    "tokenUrl": "https://copilot.tencent.com/v2/plugin/auth/token",
    "scope": "-",
    "params": [
      {
        "name": "platform",
        "value": "CLI"
      }
    ],
    "callHeaders": {
      "User-Agent": "CLI/2.63.2 CodeBuddy/2.63.2",
      "X-Requested-With": "XMLHttpRequest",
      "X-Domain": "copilot.tencent.com",
      "X-Product": "SaaS"
    },
    "refresh": {
      "encoding": "json",
      "leadSeconds": 300,
      "url": "https://copilot.tencent.com/v2/plugin/auth/token/refresh"
    }
  },
