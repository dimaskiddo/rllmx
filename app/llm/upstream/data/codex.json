{
  "id": "codex",
  "alias": "cx",
  "category": "oauth",
  "display": {
    "name": "OpenAI Codex"
  },
  "transport": {
    "baseUrl": "https://chatgpt.com/backend-api/codex/responses",
    "format": "openai-responses",
    "quirks": {
      "inlineImages": true
    }
  },
  "oauth": {
    "flow": "code-pkce",
    "bulk": true,
    "authorizeUrl": "https://auth.openai.com/oauth/authorize",
    "tokenUrl": "https://auth.openai.com/oauth/token",
    "scope": "openid profile email offline_access",
    "params": [
      {
        "name": "id_token_add_organizations",
        "value": "true"
      },
      {
        "name": "codex_cli_simplified_flow",
        "value": "true"
      },
      {
        "name": "originator",
        "value": "codex_cli_rs"
      }
    ],
    "redirect": "fixed",
    "fixedPort": 1455,
    "callbackPath": "/auth/callback",
    "exchange": "form",
    "hook": "codex",
    "refresh": {
      "encoding": "json",
      "leadSeconds": 600,
      "maxAgeSeconds": 691200
    },
    "identity": {
      "originator": "codex_cli_rs",
      "User-Agent": "codex_cli_rs/0.167.1",
      "version": "0.167.1"
    },
    "session": {
      "name": "session_id",
      "keyed": true
    },
    "account": {
      "name": "ChatGPT-Account-ID",
      "from": [
        "workspaceId",
        "chatgptAccountId",
        "accountId"
      ]
    }
  },
  "models": [
    {
      "id": "gpt-6.1-sol",
      "name": "GPT 6.1 Sol",
      "lite": true,
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "id": "gpt-6.1-terra",
      "name": "GPT 6.1 Terra",
      "lite": true,
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "id": "gpt-6-astra",
      "name": "GPT 6.0 Astra"
    },
    {
      "id": "gpt-6-sol",
      "name": "GPT 6.0 Sol",
      "lite": true,
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "id": "gpt-6-luna",
      "name": "GPT 6.0 Luna",
      "lite": true,
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    {
      "id": "gpt-5.6-sol",
      "name": "GPT 5.6 Sol"
    },
    {
      "id": "gpt-5.6-terra",
      "name": "GPT 5.6 Terra"
    },
    {
      "id": "gpt-5.6-luna",
      "name": "GPT 5.6 Luna"
    },
    {
      "id": "gpt-daybreak-blue-latest",
      "name": "GPT Daybreak Blue"
    },
    {
      "id": "gpt-reserve",
      "name": "GPT Reserve"
    },
    {
      "id": "codex-auto-review",
      "name": "Codex Auto Review",
      "upstreamId": "codex-auto-review"
    },
    {
      "id": "gpt-5.6-sol-review",
      "name": "GPT 5.6 Sol Review",
      "upstreamId": "gpt-5.6-sol"
    },
    {
      "id": "gpt-5.6-terra-review",
      "name": "GPT 5.6 Terra Review",
      "upstreamId": "gpt-5.6-terra"
    },
    {
      "id": "gpt-5.6-luna-review",
      "name": "GPT 5.6 Luna Review",
      "upstreamId": "gpt-5.6-luna"
    },

    { "id": "gpt-image-2.5", "name": "GPT Image 2.5", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-2.5-flare", "name": "GPT Image 2.5 Flare", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-2.5-sunburst", "name": "GPT Image 2.5 Sunburst", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-2.6-flare", "name": "GPT Image 2.6 Flare", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-2.6-sunburst", "name": "GPT Image 2.6 Sunburst", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-2", "name": "GPT Image 2", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-image-1.5", "name": "GPT Image 1.5", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "gpt-6-sol-image", "name": "GPT 6.0 Sol Image", "kind": "image", "params": ["size", "quality", "background", "image_detail", "output_format"] },
    { "id": "transcribe", "name": "Codex Transcription", "kind": "stt", "params": ["response_format"] }
  ],
  "executor": "codex",
  "forceStream": true,
  "media": {
    "serviceKinds": ["llm", "image", "stt"],
    "imageConfig": { "baseUrl": "https://chatgpt.com/backend-api/codex/images/generations" },
    "sttConfig": { "baseUrl": "https://chatgpt.com/backend-api/transcribe", "authType": "oauth", "format": "codex-transcribe" }
  }
}
